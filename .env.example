# 运行环境：development | test | production
NODE_ENV=development

# 服务端口
PORT=3000

# PostgreSQL 连接串（docker-compose 默认值）
DATABASE_URL=postgres://app:app@localhost:5432/app

# 日志级别：fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# 请求/响应体日志开关（排查问题时开启；记录截断 2KB，敏感字段自动脱敏）
LOG_BODY=false

# 数据库连接池大小
DB_POOL_MAX=10

# CORS 允许来源，逗号分隔多域名；留空则不启用 CORS
CORS_ORIGIN=

# 启动时自动执行数据库迁移（编译版部署常用：true）
MIGRATE_ON_START=false

# 迁移文件目录（编译版部署时通常设为 ./migrations）
MIGRATIONS_DIR=./src/db/migrations
