# ===========================================================================
# claude-agent-web 配置模板（复制为 .env 后按实际填写）
# 本地开发：直连本机 pgsql 容器；部署：用 docker-compose.yml 或编译版单文件
# ===========================================================================

# ---- 运行环境 / 服务 ----
NODE_ENV=development
PORT=3000

# ---- 数据库 ----
# docker-compose.yml 默认：postgres://app:app@localhost:5432/app
# 本机常驻容器：postgres://root:<pwd>@localhost:5432/<专用库>
DATABASE_URL=postgres://app:app@localhost:5432/app
DB_POOL_MAX=10
MIGRATE_ON_START=false
MIGRATIONS_DIR=./src/db/migrations

# ---- 日志 ----
LOG_LEVEL=info
LOG_BODY=false
LOG_DIR=./logs
LOG_RETENTION_DAYS=14

# CORS（逗号分隔多域名；留空不启用）
CORS_ORIGIN=

# ---- 认证（OA Web Service 体系）----
AUTH_WEB_SERVICE_URL=
AUTH_WEB_SERVICE_NS=
# 生产必须更换为随机 32+ 字符
AUTH_JWT_SECRET=change-me-to-a-random-32+-char-secret
# AUTH_MFA_ENC_KEY=（未设则从 AUTH_JWT_SECRET 派生）
AUTH_MFA_ISSUER=AI编码智能体-Web
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_FAILURES=5

# ---- agent 会话治理 ----
AGENT_CONFIG_ROOT=./data/claude-configs
# AGENT_WORKSPACE_ROOT=（限制项目目录必须位于此根之下；留空不限制）
AGENT_SESSION_IDLE_MINUTES=5
AGENT_SESSION_MAX_LIFE_HOURS=6
AGENT_MAX_SESSIONS_PER_USER=3
AGENT_MAX_TOTAL_SESSIONS=24

# ---- Anthropic 网关（透传给 SDK 子进程；agent 调用 LLM 必填）----
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_AUTH_TOKEN=sk-xxxxxxxx
# ANTHROPIC_MODEL=glm-4.6
