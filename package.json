{
  "name": "claude-agent-web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Bun + Hono + Drizzle + PostgreSQL backend template for AI-assisted development",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run scripts/build-exe.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docker:db": "docker compose up -d postgres",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:studio": "bunx drizzle-kit studio"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
